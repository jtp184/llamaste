#!/usr/bin/env ruby
# frozen_string_literal: true

require 'etc'
require 'digest/sha1'
require 'irb'
require 'llamaste'

TEXT_COLORIZE = {
  red: ->(text) { "\e[31m#{text}\e[0m" },
  green: ->(text) { "\e[32m#{text}\e[0m" }
}.freeze

begin
  start_time = Time.now

  File.open('tmp/basic.pid', 'w+') { |f| f << Process.pid }

  params = { model_path: '/.code/C/llama/models/Llama-2-13B-GGUF/llama-2-13b.Q5_K_M.gguf', threads: Etc.nprocessors - 1 }

  puts "Starting Backend..."
  Llamaste::Model.start_backend
  @model = Llamaste::Model.new(**params)
  puts @model.inspect
  puts "Loading Model..."
  load_time = Time.now
  loaded = @model.load

  if !loaded
    puts "Model Failed to Load"
    abort
  end

  load_finish = Time.now
  puts "Model Loaded (#{(load_finish - load_time) / 60.0} min)"

  input = 'Two yellow caterpillars ran backwards'
  tkns = @model.tokenize(input)
  puts "Tokens: #{tkns.count}"

  inf = Llamaste::Inference.new(@model, input)

  input_time = Time.now
  puts "Generating..."
  text = inf.generate(16)
  input_finish = Time.now
  puts "Input Processed (#{(input_finish - input_time) / 60.0} min)"

  # IRB.start

  puts
  print TEXT_COLORIZE[:red].call(input)
  print TEXT_COLORIZE[:green].call(text.to_s)
  puts
  puts "\a\n"
  puts "Total: #{(Time.now - start_time) / 60.0} min"

  `rm tmp/basic.pid`
ensure
  Llamaste::Model.stop_backend
end

